# ============================================================
# KUBO Vibe Dev — Game Manager Configuration
# ============================================================
# Copy this file to .env.local and fill in your Supabase credentials
#   cp .env.local.example .env.local
#
# Find your credentials at: https://supabase.com/dashboard
# → Project Settings → API

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Mirrors (for test scripts)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ============================================================
# INSTRUCTIONS
# ============================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Get your Project URL: Settings → API → Project URL
# 3. Get your anon key: Settings → API → Copy anon key
# 4. Paste values above
# 5. Rename this file to .env.local
# 6. Restart dev server: npm run dev
# 7. Create games at http://localhost:8080/games
