{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "env-check.schema.json",
  "title": "env-check report",
  "description": "Formato de reports/env-check.json gerado por scripts/setup-env.sh --validate --report-json. Validado em CI por scripts/validate-env-report.mjs.",
  "type": "object",
  "required": ["generated_at", "status", "failures", "frontend_env", "functions_env", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["pass", "fail"] },
    "failures": { "type": "integer", "minimum": 0 },
    "frontend_env": { "type": "string", "minLength": 1 },
    "functions_env": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scope", "variable", "status", "detail"],
        "additionalProperties": false,
        "properties": {
          "scope": { "type": "string", "enum": ["frontend", "functions"] },
          "variable": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["ok", "placeholder", "missing", "missing_file"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
