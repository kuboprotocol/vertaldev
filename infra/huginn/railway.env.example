# Variáveis do serviço "huginn" no Railway (imagem ghcr.io/huginn/huginn).
# Gere os valores aleatórios na hora (não reutilize estes exemplos):
#   APP_SECRET_TOKEN: openssl rand -hex 64
#   SEED_PASSWORD / INVITATION_CODE: openssl rand -base64 24
DATABASE_URL=${{huginn-postgres.DATABASE_URL}}
DATABASE_ADAPTER=postgresql
APP_SECRET_TOKEN=<openssl rand -hex 64>
DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}
FORCE_SSL=true
PORT=3000
# Cadastro de novos usuários só com este código (o admin é criado pelo seed).
INVITATION_CODE=<aleatório>
# Admin criado no primeiro boot (o seed só roda com o banco vazio). Nunca use admin/password.
SEED_USERNAME=<usuário não óbvio>
SEED_PASSWORD=<aleatório forte>
SEED_EMAIL=<seu e-mail>
TIMEZONE=Brasilia
REQUIRE_CONFIRMED_EMAIL=false
# Tamanho mínimo: 1 processo web (sem cluster do puma) + 1 worker de jobs no mesmo contêiner.
WEB_CONCURRENCY=1
RAILS_MAX_THREADS=3
DELAYED_JOB_MAX_MEMORY=384
RAILS_LOG_TO_STDOUT=true
# Sobe o proxy de saída Smokescreen; agentes podem usar "use_agent_proxy": true.
START_SMOKESCREEN=true
# SMTP (opcional, só para e-mails do Huginn como EmailAgent / redefinir senha):
# SMTP_DOMAIN=vertal.dev
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER_NAME=...
# SMTP_PASSWORD=...
# EMAIL_FROM_ADDRESS=huginn@vertal.dev
