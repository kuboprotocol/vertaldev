# Variáveis do serviço "huginn-postgres" no Railway (imagem ghcr.io/railwayapp-templates/postgres-ssl:18,
# volume em /var/lib/postgresql/data). Banco próprio do Huginn: não compartilha o Postgres do Automatisch.
POSTGRES_DB=huginn
POSTGRES_USER=huginn
POSTGRES_PASSWORD=<aleatório forte>
PGDATA=/var/lib/postgresql/data/pgdata
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
DATABASE_URL=postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}
SSL_CERT_DAYS=820
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
