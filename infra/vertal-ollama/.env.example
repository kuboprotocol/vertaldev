# Copie para .env e preencha. NUNCA comite o .env.
VERTAL_OLLAMA_DOMAIN=ollama.vertalrun.com
# Gere com: openssl rand -hex 32  (o setup.sh gera sozinho se ficar vazio)
VERTAL_OLLAMA_TOKEN=
# Modelo base (Apache-2.0). 7b ≈ 4,7 GB em disco / ≈ 5,5 GB de RAM com 8K de contexto.
# Leve: qwen3:4b (≈2,5 GB) ou qwen2.5-coder:1.5b (≈1 GB). Evite qwen2.5-coder:3b (licença não comercial).
VERTAL_OLLAMA_BASE_MODEL=qwen2.5-coder:7b
OLLAMA_MEM_LIMIT=6g
OLLAMA_CPUS=1.5
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CONTEXT_LENGTH=8192
