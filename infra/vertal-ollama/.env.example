# Copie para .env na VM (nunca commite o .env).
VERTAL_OLLAMA_DOMAIN=llm.vertal.dev
# Gere com: openssl rand -hex 32  — o mesmo valor vai no Supabase como VERTAL_OLLAMA_TOKEN
VERTAL_OLLAMA_TOKEN=
# Modelo de código para CPU (licença Apache-2.0). Alternativa rápida: qwen2.5-coder:1.5b
VERTAL_OLLAMA_MODEL=qwen2.5-coder:7b
VERTAL_OLLAMA_CTX=8192
VERTAL_OLLAMA_MEM_LIMIT=10g
