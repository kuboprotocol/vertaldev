# HTTPS automático (Let's Encrypt) + token obrigatório. Só a API compatível com OpenAI sai para fora.
# "route" mantém a ordem escrita: o token é checado ANTES de qualquer proxy
# (com "handle" + "respond" soltos, o Caddy roda o handle primeiro e o token seria ignorado).
{$VERTAL_OLLAMA_DOMAIN} {
	route {
		@unauthorized not header Authorization "Bearer {$VERTAL_OLLAMA_TOKEN}"
		respond @unauthorized "unauthorized" 401

		@allowed path /v1/chat/completions /v1/models
		reverse_proxy @allowed ollama:11434 {
			transport http {
				read_timeout 300s
			}
		}
		respond 404
	}
}
