{
  "name": "@kuboprotocol/kubovibe",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "AI-powered platform for creating SaaS, dApps, Web3 games and metaverses",
  "homepage": "https://kubovibe.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuboprotocol/kubovibe"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/validate-pwa.ts && bun scripts/check-bundle-size.ts && bun scripts/validate-deployment.ts && node scripts/smoke-test.mjs",
    "build:deploy": "vite build",
    "build:cloudflare": "vite build && bun scripts/validate-pwa.ts && bun scripts/check-bundle-size.ts && bun scripts/validate-deployment.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:prod": "SMOKE_URL=https://kubovibe.dev node scripts/smoke-test.mjs",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production && bun scripts/sentry-sourcemaps.ts",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "rm -rf node_modules/.cache && bunx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:redirect": "playwright test e2e/redirect-loop.spec.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "game:test": "vitest run src/game",
    "game:build": "vite build --outDir dist-game --minify terser",
    "perf:audit": "bun scripts/perf-audit.ts",
    "preflight:rerun": "deno run --allow-net --allow-env scripts/preflight-rerun.ts",
    "setup:env": "bash scripts/setup-env.sh",
    "setup:env:force": "bash scripts/setup-env.sh --force",
    "setup:env:dry": "bash scripts/setup-env.sh --dry-run",
    "setup:env:check": "bash scripts/setup-env.sh --validate",
    "setup:env:test": "bash scripts/setup-env.test.sh",
    "setup:env:report": "bash scripts/setup-env.sh --validate --report",
    "setup:env:report:json": "bash scripts/setup-env.sh --validate --report-json",
    "setup:env:effective": "bash scripts/setup-env.sh --print-effective",
    "setup:env:schema": "node scripts/validate-env-report.mjs",
    "prod:health": "node scripts/prod-health-check.mjs",
    "test:pr-comment": "node scripts/build-env-check-pr-comment.test.mjs",
    "deploy:render": "npm run build && curl -X POST $RENDER_DEPLOY_HOOK",
    "deploy:all": "bun run build && bun run deploy:render"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.1",
    "@heyputer/puter.js": "^2.5.1",
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.63.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.83.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/three": "^0.184.1",
    "cannon-es": "^0.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "diff": "^9.0.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.4",
    "gsap": "^3.12.2",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lil-gui": "^0.19.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "oimo": "^1.0.9",
    "p2": "^0.7.1",
    "pixi.js": "^8.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.61.1",
    "react-is": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.8.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "three-mesh-ui": "^6.5.4",
    "tldraw": "^4.4.0",
    "vaul": "^0.9.9",
    "vite-plugin-pwa": "^1.3.0",
    "webgl-debug": "^1.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@sentry/cli": "^2.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.8.0",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "lightningcss": "^1.27.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-inspect": "^0.8.7",
    "vitest": "^3.2.4"
  }
}
