// Trecho para app/build.gradle.kts do app Android Vertal Node.
// hgsdk.aar vem do dashboard do Honeygain (scripts/fetch-sdk.sh android) e NÃO é commitado.

android {
    defaultConfig {
        minSdk = 21 // mínimo exigido pelo Honeygain SDK
        // Chave do app ANDROID (diferente da chave desktop). Vem de gradle.properties local
        // (~/.gradle/gradle.properties ou variável de ambiente), nunca do repositório.
        buildConfigField(
            "String",
            "HONEYGAIN_API_KEY",
            "\"${(project.findProperty("HONEYGAIN_API_KEY") ?: System.getenv("HONEYGAIN_API_KEY") ?: "")}\""
        )
        buildConfigField(
            "String",
            "VERTAL_SUPABASE_URL",
            "\"${(project.findProperty("VERTAL_SUPABASE_URL") ?: System.getenv("VERTAL_SUPABASE_URL") ?: "")}\""
        )
        buildConfigField(
            "String",
            "VERTAL_SUPABASE_ANON_KEY",
            "\"${(project.findProperty("VERTAL_SUPABASE_ANON_KEY") ?: System.getenv("VERTAL_SUPABASE_ANON_KEY") ?: "")}\""
        )
    }
    buildFeatures { buildConfig = true }
}

dependencies {
    implementation(files("libs/hgsdk.aar"))
    implementation("org.msgpack:msgpack-core:0.9.11")
    implementation("com.google.protobuf:protobuf-javalite:3.25.3")
    implementation("org.jetbrains.kotlinx:kotlinx-coroutines-core:1.7.0")
    implementation("com.squareup.okhttp3:okhttp:4.12.0")
}
