// Exemplo de uso na Activity principal (adapte ao seu layout).
package dev.vertal.node

import android.app.Activity
import android.os.Bundle
import android.widget.Button
import android.widget.Switch
import android.widget.TextView

class MainActivity : Activity() {
    private val node get() = (application as VertalNodeApp).node

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        // Marca Vertal. O nome do fornecedor aparece na tela de consentimento do próprio SDK.
        findViewById<TextView>(R.id.disclosure).text =
            "Com a sua permissão, o Vertal Node compartilha uma parte da sua internet não usada por meio " +
            "de um parceiro de rede (este aparelho vira um ponto de saída). Antes de ligar, você vê a tela " +
            "de consentimento do parceiro, com os termos e a política de privacidade. Dá para desligar " +
            "quando quiser."

        findViewById<Button>(R.id.activate).setOnClickListener { node.activate(this) }

        // Opt-out sempre visível (exigido por Honeygain e Cash Raven)
        findViewById<Switch>(R.id.share_switch).setOnCheckedChangeListener { _, checked ->
            if (checked) node.activate(this) else node.optOut()
        }
        // Depois do login Supabase: node.setAccessToken(session.accessToken)
    }

    override fun onResume() {
        super.onResume()
        node.onResume()
        findViewById<Switch>(R.id.share_switch).isChecked = node.isOptedIn && node.isRunning
        findViewById<TextView>(R.id.status).text = when {
            !node.sdk.enabled -> "Indisponível nesta versão."
            !node.isOptedIn -> "Sem consentimento — nada está sendo compartilhado."
            node.isRunning -> "Compartilhando agora"
            node.lastError != null -> "Parado: ${node.lastError?.message}"
            else -> "Parado"
        }
    }
}
