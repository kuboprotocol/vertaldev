<?xml version="1.0" encoding="utf-8"?>
<!-- Flavor cashraven (Cash Raven SDK 4.1.4). O cr-sdk.aar já declara via manifest merge:
     INTERNET, ACCESS_NETWORK_STATE, o serviço io.cashraven.sdk.CashRavenService
     (foregroundServiceType="dataSync") e o receiver de boot (desligado por padrão).
     O app só precisa das permissões do serviço em primeiro plano (AGENTS.md do SDK).
     POST_NOTIFICATIONS fica no manifest comum (src/main) e é pedida em tempo de execução (API 33+). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: tipo do serviço em primeiro plano usado pelo CashRavenService -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Retomar depois de reiniciar o aparelho: o CrBootReceiver do SDK vem DESLIGADO e só é ligado por
         cr.setStartOnBoot(ctx, true), que o app chama depois que o usuário aceitou e ativou. No boot o SDK
         reconfere o consentimento e só religa se estava compartilhando ao desligar (Pausar/Desativar = não). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
