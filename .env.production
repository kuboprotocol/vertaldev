# Só para builds de produção (vite build). Testes/CI (modo test/development) não leem este arquivo.
# VERTAL Code AI: liga a entrada/rota no front. Quem vê de fato é decidido no servidor
# (edge function vertal-code-ai: VERTAL_CODE_AI_ENABLED + VERTAL_CODE_AI_USER_IDS); os demais não veem nada.
VITE_VERTAL_CODE_AI=true
# Vertal Chat · Tarefas agendadas: liga o botão/painel no front. Quem vê de fato é decidido no servidor
# (edge function vertal-chat-scheduler: VERTAL_CHAT_SCHEDULER_ENABLED + VERTAL_CHAT_SCHEDULER_USER_IDS).
VITE_VERTAL_CHAT_SCHEDULER=true
# Vertal Prospector: liga a rota/botão no front. Quem vê de fato é decidido no servidor
# (vertal-code-ai: VERTAL_PROSPECTOR_ENABLED + VERTAL_PROSPECTOR_USER_IDS; lista vazia = ninguém).
VITE_VERTAL_PROSPECTOR=true
