# Só para builds de produção (vite build). Testes/CI (modo test/development) não leem este arquivo.
# VERTAL Code AI: liga a entrada/rota no front. Quem vê de fato é decidido no servidor
# (edge function vertal-code-ai: VERTAL_CODE_AI_ENABLED + VERTAL_CODE_AI_USER_IDS); os demais não veem nada.
VITE_VERTAL_CODE_AI=true
# Vertal Chat · Tarefas agendadas: liga o botão/painel no front. Quem vê de fato é decidido no servidor
# (edge function vertal-chat-scheduler: VERTAL_CHAT_SCHEDULER_ENABLED + VERTAL_CHAT_SCHEDULER_USER_IDS).
VITE_VERTAL_CHAT_SCHEDULER=true
# Vertal Prospector: liga a rota/botão no front. Quem vê de fato é decidido no servidor
# (vertal-code-ai: VERTAL_PROSPECTOR_ENABLED + VERTAL_PROSPECTOR_USER_IDS; lista vazia = ninguém).
VITE_VERTAL_PROSPECTOR=true
# Vertal Growth Team: botão "Buscar clientes" e /vertal-code-ai/growth; o servidor libera por usuário
# (vertal-code-ai: VERTAL_GROWTH_TEAM_ENABLED + a mesma lista VERTAL_PROSPECTOR_USER_IDS).
VITE_VERTAL_GROWTH_TEAM=true
# Vertal CRM: cartão fixado em Conectores, rota /crm e botão "CRM" no Vertal Chat; o servidor libera por usuário
# (vertal-code-ai ?app=crm: VERTAL_CRM_ENABLED + VERTAL_CRM_USER_IDS; lista vazia = ninguém).
VITE_VERTAL_CRM=true
# Atalhos só de interface no /builder: "/crm" abre o Vertal CRM, "buscar clientes para meu app" abre o Vertal Growth.
# Só agem para quem tem o produto liberado no servidor (mesmas allowlists); prompts/roteamento não mudam.
VITE_VERTAL_BUILDER_SHORTCUTS=true
# /chat e /vertal-chat (antes 404) redirecionam para /builder.
VITE_VERTAL_CHAT_ALIASES=true
# Vídeo premiado (painel de recompensas /shortlinks): chave PÚBLICA do SDK web da AppLixir.
# Enquanto a AppLixir não aprova a conta do vertal.dev, esta é a chave sandbox compartilhada (só anúncios de teste).
# Depois da aprovação, troque pela chave própria do painel client.applixir.com. Vazio = usa o GAM, se houver.
VITE_APPLIXIR_API_KEY=5a4db0c5-0000-4000-8000-5a4db0c50001
# Vertal Mail (caixa profissional em /emails + subpáginas Gmail/Outlook em Conectores): desligado.
# Ligado com o OK do Laércio (26/11/2026): para todos; o servidor ainda exige VERTAL_GPU_CONFIG.VERTAL_MAILBOX (userIds ["*"]).
VITE_VERTAL_MAILBOX=true
