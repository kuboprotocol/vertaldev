# ============================================================
# KUBO VIBE DEV — .env.example (frontend / Vite)
# ============================================================
# Copy to `.env` and fill in the values.
#   cp .env.example .env
#
# ⚠️  Only VITE_* variables are exposed to the browser bundle.
#     Never put secret keys (service_role, Stripe secret, etc.) here.
#     Use Lovable Cloud Secrets for backend / edge function secrets.
# ============================================================

# --- Lovable Cloud (Supabase) — publishable / anon ----------
# Dashboard → Project Settings → API
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# Mirrors (some scripts/tests read the non-VITE names)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# --- Optional: RLS realtime test secret ---------------------
# Used by src/test/realtime-rls.test.ts. Must match the RLS_TEST_SECRET
# stored in Lovable Cloud Secrets (server-side).
VITE_RLS_TEST_SECRET=""

# --- Recompensas: vídeo premiado (GAM) e Vertal Node (SDKs de banda) — docs/NODE-SDKS.md ---
# Ad unit do Google Ad Manager para rewarded web (ex.: /1234567/vertal_rewarded_web).
# Vazio = botão "Assistir vídeo e ganhar créditos" desabilitado ("em breve").
VITE_GAM_REWARDED_AD_UNIT=""
# Links de download do Vertal Node (https). Vazio = botão some.
VITE_VERTAL_NODE_DESKTOP_URL=""
VITE_VERTAL_NODE_ANDROID_URL=""

# Edge Function vertal-node-heartbeat (secrets do Supabase, não do build do site):
# VERTAL_NODE_DAILY_CREDITS=2                 # créditos por dia ativo (0 desliga)
# VERTAL_NODE_CREDIT_PER_PROVIDER=false       # true = 1 crédito/dia POR provedor (padrão: 1/dia no total)
# VERTAL_NODE_PROVIDERS=honeygain,cashraven   # provedores aceitos

# Apps nativos do Vertal Node (build/execução local ou CI; NUNCA commitar valores reais).
# Um provedor ativo por dispositivo: honeygain | cashraven (pawns/bright/infatica/earnfm: aguardando aprovação)
# NODE_SDK_PROVIDER=honeygain
# HONEYGAIN_API_KEY=""            # chave do app desktop Honeygain
# HONEYGAIN_API_KEY_ANDROID=""    # chave do app Android Honeygain
# CASHRAVEN_API_KEY_DESKTOP=""    # developer key do app "Vertal Node Desktop" (Cash Raven)
# CASHRAVEN_API_KEY_ANDROID=""    # developer key do app "Vertal Android" (Cash Raven)
# VERTAL_SUPABASE_URL=""
# VERTAL_SUPABASE_ANON_KEY=""
