exports[`welcome v2 · conteúdo > HTML: logo com alt "Vertal", botão para a documentação, sem nomes de fornecedor 1`] = `
"<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Welcome to Vertal Dev, Ana</title>
<style>
@media (max-width:620px){.v-container{width:100%!important}.v-pad{padding-left:20px!important;padding-right:20px!important}}
@media (prefers-color-scheme:dark){.v-body{background:#0b0b12!important}.v-card{background:#14141f!important}.v-card td,.v-card p{color:#e8e8f0!important}.v-muted{color:#a1a1b5!important}}
</style>
</head>
<body class="v-body" style="margin:0;padding:0;background:#f3f2f8;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">Everything you need to build, launch and grow is already in your account.&#8203;&#160;&#8203;&#160;&#8203;&#160;&#8203;&#160;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="v-body" style="background:#f3f2f8;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" class="v-container" style="width:600px;max-width:600px;">
<tr><td align="center" style="background:#0b0b12;border-radius:16px 16px 0 0;padding:28px 24px;">
<a href="https://vertal.dev" style="text-decoration:none;"><img src="https://vertal.dev/pwa-512x512.png" width="88" height="88" alt="Vertal" style="display:block;width:88px;height:88px;border:0;outline:none;text-decoration:none;color:#ffffff;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:20px;font-weight:700;"></a>
</td></tr>
<tr><td class="v-card v-pad" style="background:#ffffff;border-radius:0 0 16px 16px;padding:32px 40px 36px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">Hi Ana,</p>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">Welcome to Vertal Dev. We're really glad you're here.</p>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">Your account comes with a full set of tools to build, launch and run your projects, and most of them cost nothing. Here's what's waiting for you:</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 8px;">
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><a href="https://vertal.dev/crm" style="color:#6d28d9;text-decoration:underline;font-weight:600;">Free CRM</a>: keep your contacts, companies and deals in one place, with no monthly fee. It&#39;s opening soon, and you can join the waitlist today.</td></tr>
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><strong style="font-weight:600;color:#1f2330;">Deploy and rendering</strong>: put your projects online in a few clicks and watch them come to life as you build.</td></tr>
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><a href="https://vertal.app" style="color:#6d28d9;text-decoration:underline;font-weight:600;">Vertal App</a>: take a project from your repository to a live app, with AI that detects your stack and build, plus live status and logs.</td></tr>
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><a href="https://vertalrun.com" style="color:#6d28d9;text-decoration:underline;font-weight:600;">Vertal Run</a>: safe, isolated sandboxes where your AI agents run Python, JavaScript and Bash code.</td></tr>
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><a href="https://vertal.dev/en/vibe-pay" style="color:#6d28d9;text-decoration:underline;font-weight:600;">Vertal Vibe Pay</a>: a digital account to get paid in multiple currencies, with Pix, cards and payment links. It&#39;s opening soon.</td></tr>
<tr><td valign="top" style="padding:0 10px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#7c3aed;">&#8226;</td><td valign="top" style="padding:0 0 12px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;"><a href="https://vertal.dev/creative" style="color:#6d28d9;text-decoration:underline;font-weight:600;">Premium Design, CAD and Office tools</a>: free whenever you use them manually.</td></tr>
</table>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">You only pay for Vertal AI, and only for what you use, with credits you control.</p>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">The best way to get started is our documentation. Spend a few minutes there and you'll find guides, examples and shortcuts that make everything easier.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px;">
<tr><td align="center" bgcolor="#7c3aed" style="border-radius:12px;background:#7c3aed;">
<a href="https://vertal.dev/docs" style="display:inline-block;padding:14px 28px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:12px;">Explore the docs</a>
</td></tr>
</table>
<p style="margin:0 0 16px;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">If you have a question or an idea, just reply to this email. We'd love to hear from you.</p>
<p style="margin:0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.6;color:#1f2330;">Welcome aboard,<br>Laércio Borges<br><span class="v-muted" style="color:#5b5f6e;">Founder, Vertal</span></p>
</td></tr>
</table>
</td></tr>
<tr><td align="center" class="v-muted" style="padding:20px 12px 0;font-family:Inter,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#7a7d8c;">
You're receiving this because you created a Vertal Dev account.<br><a href="https://vertal.dev" style="color:#7a7d8c;text-decoration:underline;">vertal.dev</a>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
"
`;

exports[`welcome v2 · conteúdo > assunto, pré-cabeçalho e versão texto exatamente como aprovados 1`] = `
"Hi Ana,

Welcome to Vertal Dev. We're really glad you're here.

Your account comes with a full set of tools to build, launch and run your projects, and most of them cost nothing. Here's what's waiting for you:

• Free CRM: keep your contacts, companies and deals in one place, with no monthly fee. It's opening soon, and you can join the waitlist today. (https://vertal.dev/crm)
• Deploy and rendering: put your projects online in a few clicks and watch them come to life as you build.
• Vertal App: take a project from your repository to a live app, with AI that detects your stack and build, plus live status and logs. (https://vertal.app)
• Vertal Run: safe, isolated sandboxes where your AI agents run Python, JavaScript and Bash code. (https://vertalrun.com)
• Vertal Vibe Pay: a digital account to get paid in multiple currencies, with Pix, cards and payment links. It's opening soon. (https://vertal.dev/en/vibe-pay)
• Premium Design, CAD and Office tools: free whenever you use them manually. (https://vertal.dev/creative)

You only pay for Vertal AI, and only for what you use, with credits you control.

The best way to get started is our documentation. Spend a few minutes there and you'll find guides, examples and shortcuts that make everything easier.

Explore the docs: https://vertal.dev/docs

If you have a question or an idea, just reply to this email. We'd love to hear from you.

Welcome aboard,
Laércio Borges
Founder, Vertal
"
`;
