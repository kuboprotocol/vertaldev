// Hospedagem do site na Cloudflare (Workers com static assets).
//
// Workers Builds (painel da Cloudflare → Workers → vertaldev → Settings → Build):
//   Repositório:    kuboprotocol/vertaldev (antigo kuboprotocol/kubovibe; se o
//                   build falhar no mesmo segundo em que começa, reconecte o
//                   repositório no painel), branch de produção: main
//   Build command:  npm run build   (o smoke test com Chromium é pulado quando
//                                    WORKERS_CI=1; `npm run build:cloudflare`
//                                    também funciona)
//   Deploy command: npx wrangler deploy
// O `name` precisa ser igual ao nome do Worker no painel.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vertaldev",
  "compatibility_date": "2026-09-25",
  // Rotas com `/*`: sem o curinga a rota só casa com a página inicial e
  // /pricing, /alternativas etc. não chegam ao Worker. O deploy recria as
  // rotas a partir daqui, então não dependem do painel.
  "routes": [
    { "pattern": "vertal.dev/*", "zone_name": "vertal.dev" },
    { "pattern": "www.vertal.dev/*", "zone_name": "vertal.dev" }
  ],
  "assets": {
    "directory": "./dist",
    // SPA: rotas do React Router (/pricing, /alternativas/…) devolvem o
    // index.html em vez de 404.
    "not_found_handling": "single-page-application"
  },
  // Requerido pelo Wrangler 4.135.0+ para o comando `wrangler preview`.
  "previews": {}
}
